				"name": "entity relationship sample",
				"title": "My Entity Relationship Diagram"
			},
			{
				"description": "My Gantt Chart Accessibility Description",
				"diagramBody": "gantt\n\t\t\ttitle A Gantt Diagram\n\t\t\tdateFormat\tYYYY-MM-DD\n\t\t\tsection Section\n\t\t\tA task\t\t\t\t  :a1, 2014-01-01, 30d",
				"name": "gantt sample",
				"title": "My Gantt Chart Accessibility Title"
			},
			{
				"description": "My GitGraph Accessibility Description",
				"diagramBody": "gitGraph\n\t\t\tcommit\n\t\t\tcommit\n\t\t\tbranch develop",
				"name": "gitgraph sample",
				"title": "My GitGraph Accessibility Title"
			},
			{
				"description": "My Pie Chart Accessibility Description",
				"diagramBody": "pie\n\t\t\ttitle Key elements in Product X\n\t\t\t\"Calcium\" : 42.96\n\t\t\t\"Potassium\" : 50.05",
				"name": "pie sample",
				"title": "My Pie Chart Accessibility Title"
			},
			{
				"description": "My Requirement Diagram Description",
				"diagramBody": "requirementDiagram\n\t\t\trequirement test_req {\n\t\t\tid: 1\n\t\t\ttext: the test text.\n\t\t\trisk: high\n\t\t\tverifymethod: test\n\t\t\t}\n\t\t\telement test_entity {\n\t\t\ttype: simulation\n\t\t\t}\n\t\t\ttest_entity - satisfies -> test_req",
				"name": "requirement diagram sample",
				"title": "My Requirement Diagram"
			},
			{
				"description": "My Sequence Diagram Description",
				"diagramBody": "sequenceDiagram\n\t\t\tAlice->>John: Hello John, how are you?\n\t\t\tJohn-->>Alice: Great!",
				"name": "sequence diagram sample",
				"title": "My Sequence Diagram"
			},
			{
				"description": "My State Diagram Description",
				"diagramBody": "stateDiagram\n\t\t\ts1 --> s2",
				"name": "state diagram sample",
				"title": "My State Diagram"
			},
			{
				"description": "My User Journey Diagram Description",
				"diagramBody": "journey\n\t\t\ttitle My working day\n\t\t\tsection Go to work\n\t\t\tMake tea: 5: Me",
				"name": "journey diagram sample",
				"skipStrictTitleCheck": true,
				"title": "My User Journey Diagram"
			}
		]
