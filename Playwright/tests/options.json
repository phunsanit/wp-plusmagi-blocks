	"configSyntaxReference": {
		"syntaxConfigCases": [
			{
				"expectedText": "section Waffle",
				"name": "frontmatter config example",
				"source": "---\ntitle: Frontmatter Example\ndisplayMode: compact\nconfig:\n theme: forest\n gantt:\n\t\tuseWidth: 400\n---\ngantt\n\tsection Waffle\n\t\tIron   : 1982, 3y\n\t\tHouse : 1986, 3y"
			},
			{
				"expectedText": "Start",
				"name": "look handDrawn with neutral theme",
				"source": "---\nconfig:\n   look: handDrawn\n   theme: neutral\n---\nflowchart LR\n\tA[Start] --> B{Decision}\n\tB -->|Yes| C[Continue]\n\tB -->|No| D[Stop]"
			},
			{
				"expectedText": "Decision",
				"name": "elk layout selection",
				"source": "---\nconfig:\n   layout: elk\n   look: handDrawn\n   theme: dark\n---\nflowchart TB\n\tA[Start] --> B{Decision}\n\tB -->|Yes| C[Continue]\n\tB -->|No| D[Stop]"
			},
			{
				"expectedText": "Choose Path",
				"name": "elk customized options",
				"source": "---\nconfig:\n   layout: elk\n   elk:\n\t  mergeEdges: true\n\t  nodePlacementStrategy: LINEAR_SEGMENTS\n---\nflowchart LR\n\tA[Start] --> B{Choose Path}\n\tB -->|Option 1| C[Path 1]\n\tB -->|Option 2| D[Path 2]"
			},
			{
				"expectedText": "Path 1",
				"name": "dagre with classic look",
				"source": "---\nconfig:\n   layout: dagre\n look: classic\n theme: default\n---\nflowchart LR\n\tA[Start] --> B{Choose Path}\n\tB -->|Option 1| C[Path 1]\n\tB -->|Option 2| D[Path 2]"
			}
		]
	},
