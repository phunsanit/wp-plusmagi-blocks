			{
				"expectedText": "Electricity grid",
				"name": "basic csv rows",
				"source": "sankey\n\nElectricity grid,Heating and cooling - homes,113.726\nElectricity grid,Industry,342.165\nElectricity grid,Losses,56.691"
			},
			{
				"expectedText": "Bio-conversion",
				"name": "empty lines",
				"source": "sankey\n\nBio-conversion,Losses,26.862\n\nBio-conversion,Solid,280.322\n\nBio-conversion,Gas,81.144"
			},
			{
				"expectedText": "Pumped heat",
				"name": "quoted commas",
				"source": "sankey\n\nPumped heat,\"Heating and cooling, homes\",193.026\nPumped heat,\"Heating and cooling, commercial\",70.672"
			},
			{
				"expectedText": "Pumped heat",
				"name": "escaped double quotes",
				"source": "sankey\n\nPumped heat,\"Heating and cooling, \"\"homes\"\"\",193.026\nPumped heat,\"Heating and cooling, \"\"commercial\"\"\",70.672"
			}
		]
