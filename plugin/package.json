{
  "name": "@plusmagi/plugin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build && vite build --config vite.config.description-list.ts && vite build --config vite.config.table-style.ts && npm run build:zenuml",
    "build:zenuml": "node scripts/copy-zenuml.mjs && vite build --config vite.config.zenuml.ts",
    "dev": "vite",
    "dev:description-list": "vite --config vite.config.description-list.ts",
    "dev:table-style": "vite --config vite.config.table-style.ts"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "mermaid": "^11.16.0"
  }
}
